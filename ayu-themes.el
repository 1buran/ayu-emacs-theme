;;; Commands

(defun ayu-themes--enabled ()
  "Return the Ayu theme currently enabled, if any."
  (car (seq-filter (lambda (theme) (memq theme ayu-themes-themes))
                   custom-enabled-themes)))

(defun ayu-themes--flavour-of (theme)
  "Return the flavour symbol of the Ayu THEME, if any."
  (car (seq-filter (lambda (flavour)
                     (eq theme (intern (concat "ayu-" (symbol-name flavour)))))
                   ayu-themes-flavours)))

(defun ayu-themes-refresh ()
  "Reload the enabled Ayu theme.
Run this after changing one of the `ayu-themes-*' options: the face
specs of a theme are computed when the theme is defined, so they
have to be rebuilt for a change to show up."
  (interactive)
  (let ((theme (ayu-themes--enabled)))
    (unless theme
      (user-error "No Ayu theme is enabled"))
    (load-theme theme t)))

(defun ayu-themes-load (flavour)
  "Load the Ayu theme of FLAVOUR, disabling the other Ayu themes.
FLAVOUR is one of `ayu-themes-flavours', that is `night', `dusk'
or `day'.  Themes other than the Ayu ones are left alone."
  (interactive
   (list (intern (completing-read "Ayu flavour: "
                                  (mapcar #'symbol-name ayu-themes-flavours)
                                  nil t))))
  (unless (memq flavour ayu-themes-flavours)
    (user-error "Unknown Ayu flavour: %s" flavour))
  (dolist (theme ayu-themes-themes)
    (when (memq theme custom-enabled-themes)
      (disable-theme theme)))
  (load-theme (intern (concat "ayu-" (symbol-name flavour))) t))

(defun ayu-themes-cycle ()
  "Load the next Ayu flavour: night, then dusk, then day."
  (interactive)
  (let ((next (or (car (cdr (memq (ayu-themes--flavour-of (ayu-themes--enabled))
                                  ayu-themes-flavours)))
                  (car ayu-themes-flavours))))
    (ayu-themes-load next)
    (message "Ayu flavour: %s" next)))

(defun ayu-themes--toggle (option)
  "Toggle boolean OPTION and rebuild the enabled Ayu theme."
  (customize-set-variable option (not (symbol-value option)))
  (when (ayu-themes--enabled)
    (ayu-themes-refresh))
  (message "%s: %s" option (symbol-value option)))

(defun ayu-themes-toggle-italic-comments ()
  "Toggle italics for comments and documentation."
  (interactive)
  (ayu-themes--toggle 'ayu-themes-italic-comments))

(defun ayu-themes-toggle-contrasted-comments ()
  "Toggle the contrasted comment colour."
  (interactive)
  (ayu-themes--toggle 'ayu-themes-contrasted-comments))

(defun ayu-themes-toggle-contrasted-syntax ()
  "Toggle the contrasted syntax colours."
  (interactive)
  (ayu-themes--toggle 'ayu-themes-contrasted-syntax))

(defun ayu-themes-toggle-contrasted-foreground ()
  "Toggle the contrasted `default' foreground."
  (interactive)
  (ayu-themes--toggle 'ayu-themes-contrasted-foreground))

(defun ayu-themes-toggle-org-headline-scaling ()
  "Toggle the scaling of `org-mode' headlines."
  (interactive)
  (ayu-themes--toggle 'ayu-themes-scale-org-headlines))

(defun ayu-themes-toggle-org-intense-colors ()
  "Toggle the emphasised colours of `org-mode' headlines."
  (interactive)
  (ayu-themes--toggle 'ayu-themes-org-intense-colors))

(defun ayu-themes-toggle-mode-line-border ()
  "Toggle the border around the mode line."
  (interactive)
  (ayu-themes--toggle 'ayu-themes-mode-line-border))

