;;; Commentary:

;; This is the core library of the Ayu themes for Emacs.  It holds the three
;; official Ayu palettes, the options and the whole list of face definitions.
;; The concrete themes live in the sibling files `ayu-night-theme.el',
;; `ayu-dusk-theme.el' and `ayu-day-theme.el', which simply call
;; `ayu-themes-define-theme'.  See the README for installation instructions.
;;
;; The palettes are the official Ayu colours, taken from
;; <https://github.com/ayu-theme/ayu-colors> (`themes/dark.yaml',
;; `themes/mirage.yaml' and `themes/light.yaml', aka night, dusk and day).
;; Every hex value below is the resolved output of the official generator, so
;; the theme matches what <https://ayutheme.com/> renders.  The syntax colours
;; follow the official TextMate scope mapping that ships with ayu-colors
;; (`designer/lib/shiki-theme.ts'), translated to Emacs faces:
;;
;;   comment                                    -> font-lock-comment-*
;;   string, entity.name.import                 -> font-lock-string-face
;;   constant.numeric, constant.language        -> font-lock-constant-face
;;   variable                                   -> font-lock-variable-name-face
;;   variable.member (object property)          -> font-lock-property-*-face
;;   variable.language (this/self/super)        -> font-lock-builtin-face
;;   storage, keyword, keyword.control          -> font-lock-keyword-face
;;   keyword.operator, punctuation.accessor     -> font-lock-operator-face
;;   entity.name.type / class / module          -> font-lock-type-face
;;   entity.name.function, variable.function    -> font-lock-function-name-face
;;   variable.parameter (function arguments)    -> font-lock-variable-... (constant)
;;   support.function / support.macro           -> font-lock-builtin-face
;;   support.type / support.class               -> font-lock-type-face
;;   entity.name.tag                            -> tag faces (html/XML)
;;   entity.other.attribute-name                -> attribute faces
;;   punctuation                                -> font-lock-punctuation-face
;;   invalid                                    -> font-lock-warning-face
;;
;; The themes only use 24-bit hex colours and a `(class color)' display spec
;; with `(min-colors 89)', so they are safe on 256-colour terminals too.
;;
;; Configuration is done with the `ayu-themes-*' options below; after changing
;; one of them run `M-x ayu-themes-refresh' (or the matching `M-x
;; ayu-themes-toggle-*' command) to rebuild the enabled theme.

;;; Code:

(require 'seq)

(defgroup ayu-themes nil
  "Ayu colour themes for Emacs."
  :group 'faces
  :prefix "ayu-themes-"
  :link '(url-link "https://ayutheme.com/"))

(defconst ayu-themes-themes '(ayu-night ayu-dusk ayu-day)
  "The themes provided by this package, from darkest to lightest.")

(defconst ayu-themes-flavours '(night dusk day)
  "The Ayu flavours, from darkest to lightest.")


;;; Options

(defcustom ayu-themes-italic-comments t
  "Whether to render comments, docs and block quotes in italics.
This only affects faces that are not italic by design (markdown
emphasis, for instance, stays italic either way)."
  :type 'boolean
  :group 'ayu-themes)

(defcustom ayu-themes-contrasted-comments nil
  "Whether to use a more contrasted colour for comments and docs.
Ayu's comment colour is deliberately subdued; enable this if you
find it too faint."
  :type 'boolean
  :group 'ayu-themes)

(defcustom ayu-themes-contrasted-syntax nil
  "Whether to use more contrasted colour variants for syntax highlighting.
Ayu's colours are picked for its own, deliberately soft, look.  The
effect is subtle for the dark flavours and quite noticeable for the
`day' flavour, whose palette is fairly light.  Comments are not
affected; see `ayu-themes-contrasted-comments' for those."
  :type 'boolean
  :group 'ayu-themes)

(defcustom ayu-themes-contrasted-foreground nil
  "Whether to use a more contrasted `default' foreground."
  :type 'boolean
  :group 'ayu-themes)

(defcustom ayu-themes-scale-org-headlines nil
  "Whether to scale `org-mode' headlines (`org-level-1' to `org-level-3').
Possible values are:

  nil      no scaling at all (the default);
  t        the theme's default heights (1.3, 1.15 and 1.05);
  NUMBER   a single custom height for all three levels."
  :type '(choice (const :tag "No scaling" nil)
                 (const :tag "Theme default scaling" t)
                 (number :tag "Custom scaling"))
  :group 'ayu-themes)

(defcustom ayu-themes-org-intense-colors nil
  "Whether to emphasise `org-mode' headlines with a background.
When non-nil the first eight `org-level-N' faces get an overline and
a tinted background, which makes the document structure stand out."
  :type 'boolean
  :group 'ayu-themes)

(defcustom ayu-themes-mode-line-border nil
  "Whether to draw a border around the mode line."
  :type 'boolean
  :group 'ayu-themes)


