;;; Helpers

(defconst ayu-themes--class '((class color) (min-colors 89))
  "Display spec every face of this theme uses.")

(defvar ayu-themes--palette nil
  "Alist of colours currently in use, see `ayu-themes-palettes'.")

(defmacro ayu (color)
  "Return the value of COLOR from the palette being defined.
This is an internal macro of `ayu-themes'; it is only meaningful
while `ayu-themes-define-theme' builds a theme."
  `(or (cdr (assq ,color ayu-themes--palette))
       (error "ayu-themes: no such palette entry: %s" ,color)))

(defun ayu-themes--syntax (color)
  "Return syntax colour COLOR, honouring `ayu-themes-contrasted-syntax'.
COLOR is one of the `syntax-*' palette entries."
  (ayu (if ayu-themes-contrasted-syntax
           (intern (concat (symbol-name color) "-strong"))
         color)))

(defun ayu-themes--comment (&optional roman)
  "Face attributes for comments, docs and quotes.
Unless ROMAN is non-nil the result is slanted when
`ayu-themes-italic-comments' is non-nil."
  (append (list :foreground (if ayu-themes-contrasted-comments
                                (ayu 'comment-strong)
                              (ayu 'syntax-comment)))
          (unless (or roman (not ayu-themes-italic-comments))
            (list :slant 'italic))))

(defun ayu-themes--foreground ()
  "Face attributes for the `default' foreground."
  (list :foreground (if ayu-themes-contrasted-foreground
                        (ayu 'fg-strong)
                      (ayu 'fg))))

(defun ayu-themes--scale (default)
  "Face attributes scaling an `org' headline to DEFAULT (a float).
The value of `ayu-themes-scale-org-headlines' decides whether the
scaling is applied at all."
  (pcase ayu-themes-scale-org-headlines
    ('t (list :height default))
    ((pred numberp) (list :height (float ayu-themes-scale-org-headlines)))
    (_ nil)))

(defun ayu-themes--intense (overline background)
  "Face attributes emphasising an `org' headline.
OVERLINE and BACKGROUND are only used when
`ayu-themes-org-intense-colors' is non-nil."
  (when ayu-themes-org-intense-colors
    (list :overline overline :background background)))

(defun ayu-themes--mode-line-border (&optional inactive)
  "Face attributes adding a border to a mode line.
This returns nil unless `ayu-themes-mode-line-border' is non-nil.
INACTIVE selects the colour of an inactive mode line."
  (when ayu-themes-mode-line-border
    (list :box (list :line-width 1
                     :color (if inactive (ayu 'border) (ayu 'border-strong))))))

(defun ayu-themes--face-specs ()
  "Return the face specs of the current palette.
The result has the shape expected by `custom-theme-set-faces'."
  (append (ayu-themes--faces-base)
          (ayu-themes--faces-font-lock)
          (ayu-themes--faces-lang)
          (ayu-themes--faces-org)
          (ayu-themes--faces-text)
          (ayu-themes--faces-completion)
          (ayu-themes--faces-diagnostics)
          (ayu-themes--faces-vc)
          (ayu-themes--faces-files)
          (ayu-themes--faces-modeline)
          (ayu-themes--faces-term)
          (ayu-themes--faces-misc)))

(defun ayu-themes--variables ()
  "Return the theme variables of the current palette."
  (list (list 'ansi-color-names-vector
              (vector (ayu 'bg) (ayu 'term-red) (ayu 'term-green) (ayu 'term-yellow)
                      (ayu 'term-blue) (ayu 'term-magenta) (ayu 'term-cyan) (ayu 'fg)))))

(defmacro ayu-themes-define-theme (theme flavour docstring)
  "Define THEME from the Ayu FLAVOUR, documented by DOCSTRING.
THEME is a symbol, FLAVOUR one of `ayu-themes-flavours'.  This is
what the `ayu-*-theme.el' files call."
  `(progn
     (deftheme ,theme ,docstring)
     (let ((ayu-themes--palette (alist-get ',flavour ayu-themes-palettes)))
       (apply #'custom-theme-set-faces ',theme (ayu-themes--face-specs))
       (apply #'custom-theme-set-variables ',theme (ayu-themes--variables)))
     (provide-theme ',theme)))


;;; Core UI

(defun ayu-themes--faces-base ()
  "Faces of the Emacs core UI."
  (let ((c ayu-themes--class))
    `(;; --- basics -------------------------------------------------------
      (default ((,c (:background ,(ayu 'bg) ,@(ayu-themes--foreground)))))
      (cursor ((,c (:background ,(ayu 'accent) :foreground ,(ayu 'bg)))))
      (bold ((,c (:weight bold))))
      (italic ((,c (:slant italic))))
      (bold-italic ((,c (:weight bold :slant italic))))
      (underline ((,c (:underline t))))
      (escape-glyph ((,c (:foreground ,(ayu 'syntax-special)))))
      (homoglyph ((,c (:foreground ,(ayu 'syntax-markup)))))
      (nobreak-space ((,c (:foreground ,(ayu 'syntax-special) :underline ,(ayu 'fg-ghost)))))
      (glyphless-char ((,c (:foreground ,(ayu 'fg-ghost)))))
      (shadow ((,c (:foreground ,(ayu 'fg-faint)))))
      (link ((,c (:foreground ,(ayu 'syntax-tag) :underline t))))
      (link-visited ((,c (:foreground ,(ayu 'purple-1) :underline t))))
      (button ((,c (:inherit link))))
      (bookmark-face ((,c (:foreground ,(ayu 'syntax-tag) :underline t))))
      (help-key-binding ((,c (:foreground ,(ayu 'syntax-special)
                                         :background ,(ayu 'bg-alt)
                                         :box ,(ayu 'border-strong)))))

      ;; --- selection & highlighting ------------------------------------
      (region ((,c (:background ,(ayu 'bg-sel) :distant-foreground ,(ayu 'bg) :extend t))))
      (secondary-selection ((,c (:background ,(ayu 'bg-sel-dim) :extend t))))
      (highlight ((,c (:background ,(ayu 'bg-alt) :extend t))))
      (hl-line ((,c (:background ,(ayu 'bg-hl) :extend t))))
      (mouse ((,c (:background ,(ayu 'bg-alt) :extend t))))
      (mouse-drag-mode-line ((,c (:background ,(ayu 'bg-dim)))))
      (mouse-drag-header-line ((,c (:background ,(ayu 'bg-dim)))))
      (pulse-highlight-start-face ((,c (:background ,(ayu 'bg-sel) :extend t))))

