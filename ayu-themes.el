;;; Org mode and outlines
;;
;; Org gets its own ramp of headline colours instead of the single green of
;; Ayu's `markup.heading', because a document needs to distinguish its levels.
;; Everything else follows the official mapping: `org-code' and `org-verbatim'
;; are the inline raw markup (operator), quotes are `markup.quote' (regexp,
;; italic), links are `markup.underline.link' (tag) and so on.

(defun ayu-themes--faces-org ()
  "Faces of `org-mode', its agenda and outline modes."
  (let ((c ayu-themes--class)
        (h1 (ayu-themes--syntax 'syntax-entity))
